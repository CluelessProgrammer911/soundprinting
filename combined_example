import asyncio
import json
import threading
import time
import os
import keyboard
import websockets

MOONRAKER_WS = "ws://192.168.101.8:7125/websocket"

listen_mode = False
loop = asyncio.new_event_loop()
ws = None

# Movement state
current_x = 0  # starting at 0 mm
MAX_X = 235
MOVE_STEP = 10

def toggle_mode():
    global listen_mode
    listen_mode = not listen_mode
    print(f"Listen mode {'ON' if listen_mode else 'OFF'}")

async def move_x():
    """Increase X by MOVE_STEP using absolute mode."""
    global current_x, ws
    
    new_x = current_x + MOVE_STEP
    if new_x > MAX_X:
        print(f"X limit reached! Currently at {current_x} mm; cannot move further.")
        return
    
    current_x = new_x
    print(f"Moving to X={current_x} mm")
    
    if ws is None:
        print("WebSocket not connected.")
        return

    # Only send the absolute move (G90 already active)
    await ws.send(json.dumps({
        "jsonrpc": "2.0",
        "method": "printer.gcode.script",
        "params": {"script": f"G1 X{current_x} F1000"},
        "id": 3
    }))

def key_listener():
    """Thread to detect key presses."""
    global listen_mode
    while True:
        if listen_mode:
            if keyboard.is_pressed('x'):
                print("Pressed x → move +10mm")
                asyncio.run_coroutine_threadsafe(move_x(), loop)
                keyboard.wait('x')  # avoid holding key repeat
        time.sleep(0.01)

async def websocket_handler():
    """Manage WebSocket connection."""
    global ws
    async with websockets.connect(MOONRAKER_WS) as ws:
        print("Connected to Moonraker WebSocket.")
        
        # Subscribe to something (optional)
        await ws.send(json.dumps({
            "jsonrpc": "2.0",
            "method": "printer.objects.subscribe",
            "params": {"objects": {"toolhead": ["position"]}},
            "id": 1
        }))
        response = await ws.recv()
        print("Subscribed:", json.loads(response))
        
        while True:
            try:
                await ws.recv()
            except:
                print("WebSocket connection lost.")
                break

def start_asyncio_loop():
    asyncio.set_event_loop(loop)
    loop.run_until_complete(websocket_handler())

def main():
    print("Press CTRL+SHIFT+L to toggle listen mode.")
    print("Press 'x' in listen mode to move X by +10 mm (absolute mode).")
    print("X is capped at 235 mm.")
    print("Press ESC to exit.")

    keyboard.add_hotkey('ctrl+shift+l', toggle_mode)
    keyboard.add_hotkey('esc', lambda: os._exit(0))

    # Start WebSocket
    t_ws = threading.Thread(target=start_asyncio_loop, daemon=True)
    t_ws.start()

    # Start keyboard monitoring
    t_k = threading.Thread(target=key_listener, daemon=True)
    t_k.start()

    while True:
        time.sleep(1)

if __name__ == '__main__':
    main()




